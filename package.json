{
  "name": "build-it",
  "version": "0.1.0",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "tema:islas": "node scripts/generar-islas-de-tema.mjs",
    "dev": "NODE_OPTIONS='--disable-warning=DEP0205' next dev --webpack",
    "dev:lan": "node scripts/dev-lan.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "library": "storybook dev -p 6006 -c library/.storybook",
    "library:build": "storybook build -c library/.storybook -o library/storybook-static",
    "library:snapshots": "node library/scripts/snapshots.mjs",
    "library:snapshots:update": "node library/scripts/snapshots.mjs --update",
    "sync:email-templates": "node scripts/prepare-email-templates.mjs && node scripts/sync-supabase-email-templates.mjs",
    "sync:email-templates:dry-run": "node scripts/prepare-email-templates.mjs && node scripts/sync-supabase-email-templates.mjs --dry-run",
    "prepare:email-templates": "node scripts/prepare-email-templates.mjs",
    "generate:email-logo": "npx --yes @resvg/resvg-js-cli --fit-width 200 public/logo-build-on.svg public/logo-build-on-email.png && node scripts/prepare-email-templates.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@radix-ui/react-visually-hidden": "1.2.13",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-query": "^5.102.5",
    "@tanstack/react-query-devtools": "^5.102.5",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "^4.4.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.16.0",
    "next": "16.4.5",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "pg": "^8.22.0",
    "pixelmatch": "8.0.0",
    "playwright-core": "1.64.1",
    "pngjs": "7.0.0",
    "storybook": "10.6.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "7.3.7"
  }
}
