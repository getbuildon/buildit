# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: public site URL for invitation links and email template assets
# NEXT_PUBLIC_SITE_URL=https://getbuildon.com

# Backoffice: comma-separated emails allowed to access /backoffice
BACKOFFICE_ALLOWED_EMAILS=admin@example.com,other@example.com

# Supabase Management API (solo para scripts locales, ej. sync de email templates)
# Crear token en: https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_PROJECT_REF=your-project-ref
